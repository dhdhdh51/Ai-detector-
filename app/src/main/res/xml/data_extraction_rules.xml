<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ backup / device-transfer rules. Only the local database, preferences and DataStore
  file are eligible; everything else (including caches and exported files) is left out.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="fitbudget.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="fitbudget.db" />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
